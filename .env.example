# CloudDeploy Environment Configuration Template
# Copy this file to .env for local overrides (never commit .env)

FLASK_APP=app:create_app()
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-me-in-production-use-a-strong-random-key

# Application Metadata
APP_NAME=CloudDeploy
APP_VERSION=1.0.0
ENVIRONMENT=production
PORT=8000

# AWS & Infrastructure Metadata (Non-sensitive)
AWS_REGION=us-east-1
DEPLOYMENT_ID=local-dev
